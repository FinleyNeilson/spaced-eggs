// See docs/architecture.md for the data model rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Necessary for Next Auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  decks         Deck[]
  pets          Pet[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App data model — see docs/architecture.md for the reasoning behind each
// decision (SM-2 scheduling, single computed-on-demand pet health stat, etc).

model Deck {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([userId])
}

model Card {
  id     String @id @default(cuid())
  deckId String
  front  String
  back   String
  // "flashcard" | "quiz". SQLite has no native enum, so the API validates it.
  type         String  @default("flashcard")
  // JSON string containing 2-4 answer choices for quiz cards.
  optionsJson  String?
  correctIndex Int?

  // SM-2 scheduling state, updated after each review.
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(0)
  repetitions  Int      @default(0)
  dueAt        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deck       Deck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviewLogs ReviewLog[]

  @@index([deckId])
  @@index([dueAt])
}

model ReviewLog {
  id         String   @id @default(cuid())
  cardId     String
  reviewedAt DateTime @default(now())
  grade      Int

  // Snapshot of the SM-2 transition this review caused, so past scheduling
  // decisions can be inspected without recomputing them.
  previousInterval Int
  newInterval      Int
  previousEase     Float
  newEase          Float

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// health is computed on-demand from ReviewLog + Card.dueAt, scoped to a
// grace window relative to this row's createdAt (see server/pet/health.ts)
// — it's not stored.
//
// A pet's life stage/level IS derived from stored state though: a
// continuous sum of mastery progress across cards reviewed since this
// row's createdAt (see server/pet/growth.ts). Reaching "adult" retires
// this pet (retiredAt + retirementReason: "graduated") and a new blank one
// is created — see review.submit. A pet can also die (retirementReason:
// "died") if health hits 0 after its grace window — see getActivePet in
// growth.ts. userId is not @unique because a user accumulates a history
// of retired pets over time; the current one is whichever row has
// retiredAt: null.
model Pet {
  id               String    @id @default(cuid())
  userId           String
  name             String?
  // Chosen at onboarding via pet.setSpecies; null until then. String not
  // enum — SQLite doesn't support native Prisma enums; validated with
  // z.enum() at the tRPC boundary instead.
  species          String?
  retiredAt        DateTime?
  // "graduated" | "died", set only alongside retiredAt. Same not-a-native-
  // enum reasoning as species.
  retirementReason String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
